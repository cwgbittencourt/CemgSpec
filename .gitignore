# IDE and local build output
.vs/
.vscode/
.idea/
**/bin/
**/obj/
**/out/
**/publish/
**/TestResults/
*.user
*.suo
*.userosscache
*.sln.docstates

# Local caches
**/__pycache__/
*.pyc

# Credentials and private local configuration
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem
**/secrets.json

# Temporary, scratch, and local build artifacts
tmp/
/tmp/
output/
installer/dist/
docs/prints/
.specify/feature.json
.specify/presets/cemg-speckit/cemg-speckit-*/

# Intermediate test logs, historical archives, and experimental probes
specs/*/evidence/logs/
specs/*/evidence/captures/
specs/*/evidence/isolation-v2/
specs/*/evidence/T*-before/
specs/*/evidence/T*-code/
specs/*/evidence/T*-probes/
specs/*/verification/archive/
specs/*/verification/probes/
specs/*/prototype/

# Unneeded container files
Dockerfile
docker-compose*.yml
.dockerignore
