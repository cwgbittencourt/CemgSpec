@inherits LayoutComponentBase
@implements IDisposable
@using SpecAudit.Application
@inject NavigationManager Navigation
@inject ProjectService ProjectStore

<div class="app-shell" data-theme="@(isLightTheme ? "light" : "dark")">
    <aside class="app-sidebar">
        <a class="app-brand" href="/projetos">
            <span class="brand-icon" aria-hidden="true">
                <span class="brand-monogram">SA</span>
                <span class="brand-check">✓</span>
            </span>
            <span>SpecAudit</span>
        </a>
        <p class="sidebar-caption">ESPAÇO DE TRABALHO</p>
        <nav class="sidebar-nav" aria-label="Navegação principal">
            <a href="/projetos" class="@(IsRoute("", "projetos") ? "sidebar-link active" : "sidebar-link")" aria-current="@(IsRoute("", "projetos") ? "page" : null)"><span aria-hidden="true">▱</span> Projetos</a>
            <NavLink href="/dashboard" class="sidebar-link"><span aria-hidden="true">⌂</span> Dashboard</NavLink>
            <NavLink href="/requisitos" class="sidebar-link"><span aria-hidden="true">☰</span> Requisitos</NavLink>
            <NavLink href="/documentos" class="sidebar-link"><span aria-hidden="true">▤</span> Documentos</NavLink>
            <NavLink href="/sugestoes" class="sidebar-link"><span aria-hidden="true">◈</span> Sugestões</NavLink>
        </nav>

        <div class="sidebar-footer">
            @if (ProjectStore.Active is { } activeProject)
            {
                <div class="sidebar-project" title="@activeProject.Session.OriginDisplayPath">
                    <span class="sidebar-project-name">@activeProject.Session.DisplayName</span>
                </div>
            }
            <div class="sidebar-readonly" aria-label="Origem somente leitura"><span aria-hidden="true">◇</span> Somente leitura</div>
            <div class="theme-switcher" role="group" aria-label="Tema da interface">
                <button type="button" class="@(!isLightTheme ? "theme-btn active" : "theme-btn")"
                        aria-pressed="@(!isLightTheme ? "true" : "false")" @onclick="() => SetTheme(false)">Escuro</button>
                <button type="button" class="@(isLightTheme ? "theme-btn active" : "theme-btn")"
                        aria-pressed="@(isLightTheme ? "true" : "false")" @onclick="() => SetTheme(true)">Claro</button>
            </div>
        </div>
    </aside>
    <main class="app-main">
        @Body
    </main>
</div>
<div id="blazor-error-ui" data-nosnippet>Não foi possível manter a sessão. <a href=".">Recarregar</a><span class="dismiss">×</span></div>

@code {
    // Session-only theme preference; starts in dark mode per US8-AC01 and data-model.md.
    private bool isLightTheme;

    private string CurrentPath =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

    private bool IsRoute(params string[] routes) =>
        routes.Any(route => CurrentPath.Equals(route, StringComparison.OrdinalIgnoreCase));

    private void SetTheme(bool light) => isLightTheme = light;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ProjectStore.Changed += OnProjectChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnProjectChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        ProjectStore.Changed -= OnProjectChanged;
    }
}
