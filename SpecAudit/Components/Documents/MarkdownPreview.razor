@implements IAsyncDisposable
@using SpecAudit.Infrastructure.Documents
@inject IJSRuntime JS

@* The sanitized HTML is mounted by JS into an element Blazor never diffs, so the
   diagram enhancement can rearrange it safely. A new session recreates the element. *@
<section class="preview-pane" aria-label="Preview Markdown" hidden="@Hidden">
    <div @key="Session" @ref="container" class="markdown-preview preview-surface"></div>
</section>

@code {
    [Parameter, EditorRequired] public DocumentPreviewSession Session { get; set; } = null!;
    [Parameter, EditorRequired] public Guid DocumentId { get; set; }
    [Parameter] public bool Hidden { get; set; }
    [Parameter] public string? InitialElementId { get; set; }
    [Parameter] public EventCallback<PreviewNavigation> Navigate { get; set; }
    [Parameter] public EventCallback<string> Status { get; set; }

    public sealed record PreviewNavigation(Guid DocumentId, string? ElementId);
    public sealed record ReferenceAction(string Action, string? Url = null, string? ElementId = null);
    private static readonly ReferenceAction None = new("none");

    private ElementReference container;
    private IJSObjectReference? module;
    private DotNetObjectReference<MarkdownPreview>? self;
    private DocumentPreviewSession? mounted;
    private bool wasHidden;
    private int mount;
    private readonly Dictionary<string, string> authorizedImages = new(StringComparer.Ordinal);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var sessionChanged = !ReferenceEquals(mounted, Session);
        if (sessionChanged) authorizedImages.Clear();
        var becameVisible = wasHidden && !Hidden;
        wasHidden = Hidden;
        if (Hidden || (!sessionChanged && !becameVisible)) return;
        mounted = Session;
        var id = ++mount;
        self ??= DotNetObjectReference.Create(this);
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Documents/MarkdownPreview.razor.js");
            var references = Session.Preview.References.Select(reference => new { index = reference.Index, kind = reference.Kind.ToString() });
            await module.InvokeVoidAsync("mount", container, Session.Preview.Html, references, authorizedImages, self, id, InitialElementId);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async Task GoToAsync(string elementId)
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("goTo", container, elementId); }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public async Task<ReferenceAction> ActivateReference(int mountId, int index)
    {
        if (mountId != mount) return None;
        var session = Session;
        try
        {
            var link = session.ResolveLink(index);
            var target = Shorten(session.Preview.References[index].Target);
            switch (link.Status)
            {
                case PreviewLinkStatus.External:
                    return new("external", session.Preview.References[index].Target);
                case PreviewLinkStatus.Authorized when link.DocumentId == DocumentId:
                    return link.ElementId is null ? None : new("anchor", ElementId: link.ElementId);
                case PreviewLinkStatus.Authorized:
                    await Navigate.InvokeAsync(new(link.DocumentId!.Value, link.ElementId));
                    return None;
                case PreviewLinkStatus.MissingAnchor:
                    if (link.DocumentId is { } other && other != DocumentId)
                        await Navigate.InvokeAsync(new(other, null));
                    await Status.InvokeAsync($"Âncora ausente: {target}. O título indicado não existe no documento de destino.");
                    return None;
                case PreviewLinkStatus.Missing:
                    await Status.InvokeAsync($"Referência ausente: {target} não existe no catálogo do projeto.");
                    return None;
                default:
                    await Status.InvokeAsync($"Referência fora do catálogo autorizado: {target}. O destino não foi aberto.");
                    return None;
            }
        }
        catch (Exception failure) when (DocumentMessages.IsReadFailure(failure))
        {
            await Status.InvokeAsync(DocumentMessages.For(failure));
            return None;
        }
    }

    [JSInvokable]
    public async Task<string?> LoadRemoteImage(int mountId, int index)
    {
        if (mountId != mount) return null;
        try
        {
            var image = await Session.AuthorizeRemoteImageAsync(index);
            authorizedImages[index.ToString(System.Globalization.CultureInfo.InvariantCulture)] = image.DataUri;
            await Status.InvokeAsync("Imagem remota carregada somente para esta visualização, sem cookies ou credenciais.");
            return image.DataUri;
        }
        catch (Exception failure) when (DocumentMessages.IsReadFailure(failure))
        {
            await Status.InvokeAsync(DocumentMessages.For(failure));
            return null;
        }
        catch (OperationCanceledException)
        {
            await Status.InvokeAsync("O carregamento da imagem remota foi cancelado porque o projeto mudou.");
            return null;
        }
    }

    private static string Shorten(string value) => value.Length <= 160 ? value : value[..157] + "…";

    public async ValueTask DisposeAsync()
    {
        self?.Dispose();
        if (module is not null)
        {
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}

