@implements IDisposable
@using SpecAudit.Application
@using SpecAudit.Domain
@using SpecAudit.Infrastructure.Agents
@using SpecAudit.Infrastructure.Documents
@using SpecAudit.Infrastructure.Gates
@inject ProjectService ProjectStore
@inject VerificationService VerificationStore
@inject AgentCompatibilityService AgentStore
@inject RequirementTraceService TraceService
@inject GatePackage GatePkg
@inject GateExecutor Executor
@inject CodexAnalyzeAdapter CodexAdapter
@inject AntigravityAnalyzeAdapter AntigravityAdapter

@if (ProjectStore.Active is not { } active)
{
    <p class="muted small">Selecione um projeto em <a href="/projetos">Projetos</a> para configurar verificações.</p>
}
else
{
    var selectedType = VerificationStore.GetSelectedVerification(active.Session.ProjectId);
    <div class="@(Compact ? "v-selector compact" : "v-selector")">
        <div class="v-field">
            <label for="@comboId">Tipo de verificação</label>
            <select id="@comboId" aria-label="Tipo de verificação" value="@selectedType.ToString()" @onchange="OnVerificationTypeChanged" disabled="@isRunning">
                <option value="@VerificationType.AnalyzeDocuments">speckit-analyze — Consistência documental</option>
                <option value="@VerificationType.CheckGate">check_gate — Validar gates</option>
            </select>
        </div>

        @if (selectedType == VerificationType.AnalyzeDocuments)
        {
            var agentAvailability = AgentStore.EvaluateSelectedAgentAvailability(active.Session.ProjectId);
            var selectedAgent = AgentStore.GetSelectedAgent(active.Session.ProjectId);
            var missingPrereqs = GetMissingAnalyzePrerequisites(active);

            <AgentSelector Disabled="@isRunning" OnSelectionChanged="StateHasChanged" />

            @if (!Compact)
            {
                <div class="v-grid">
                    <div class="v-field">
                        <label for="@featureId">Funcionalidade</label>
                        <select id="@featureId" aria-label="Funcionalidade da análise" value="@(selectedFeatureId?.ToString() ?? "")" @onchange="OnFeatureChanged" disabled="@isRunning">
                            @foreach (var f in active.Session.Features)
                            {
                                <option value="@f.FeatureId">@f.Title</option>
                            }
                        </select>
                    </div>

                    <div class="v-field">
                        <label for="@focusReqId">Foco opcional de requisito</label>
                        <select id="@focusReqId" aria-label="Foco opcional de requisito" value="@selectedFocusLocalId" @onchange="OnFocusRequirementChanged" disabled="@isRunning">
                            <option value="">Todos os requisitos da funcionalidade</option>
                            @foreach (var reqLocalId in GetFeatureRequirementIds(active))
                            {
                                <option value="@reqLocalId">@reqLocalId</option>
                            }
                        </select>
                    </div>
                </div>
            }
            else if (FocusRequirement is not null)
            {
                <div class="v-scope-note" role="note">
                    Análise da funcionalidade com foco documental em <strong>@FocusRequirement.LocalId</strong> (destaca achados pertinentes sem executar código).
                </div>
            }

            @if (missingPrereqs.Count > 0)
            {
                <div class="v-info-box warn-box" role="alert">
                    <strong>Pré-requisitos documentais ausentes (@string.Join(", ", missingPrereqs))</strong>
                    <p class="small">O SpecAudit é somente leitura e nunca cria arquivos de pré-requisito ausentes na origem.</p>
                </div>
            }

            <div class="v-actions">
                <button type="button" class="v-btn-primary"
                        disabled="@(!CanExecuteAnalyze(agentAvailability, selectedAgent))"
                        @onclick="ExecuteAnalyzeAsync">
                    @(isRunning ? "Executando speckit-analyze..." : "Executar verificação")
                </button>
                @if (isRunning)
                {
                    <button type="button" class="v-btn-secondary" @onclick="CancelCurrentRun">Cancelar</button>
                }
            </div>

            @if (isRunning)
            {
                <div class="v-running-banner" role="status" aria-live="polite">
                    <div class="v-running-head">
                        <span class="v-spinner" aria-hidden="true"></span>
                        <strong>@runningStatusText</strong>
                        <span class="v-elapsed">@ElapsedDisplay</span>
                    </div>
                    <div class="v-progress-track" aria-hidden="true"><div class="v-progress-bar"></div></div>
                    <p class="muted small">Processo ativo aguardando resposta do agente documental. Você pode interromper a qualquer momento em <strong>Cancelar</strong>.</p>
                </div>
            }

            @if (Compact && latestCompactRun is not null)
            {
                <div class="v-compact-result" role="region" aria-label="Resultado da verificação">
                    <strong>@FormatRunSummary(latestCompactRun)</strong>
                    <span class="@(latestCompactRun.Freshness == Freshness.Stale ? "fresh-pill stale" : "fresh-pill")">
                        @(latestCompactRun.Freshness == Freshness.Stale ? "Desatualizado" : "Atual")
                    </span>
                    @if (!string.IsNullOrWhiteSpace(latestCompactRun.Reason))
                    {
                        <p class="muted small">@latestCompactRun.Reason</p>
                    }
                </div>
            }
        }
        else
        {
            var availability = EvaluateGateAvailability(active);
            var featureRecords = GetGateRecords(active);

            @if (FocusRequirement is not null)
            {
                <div class="v-scope-note" role="note">
                    Foco documental em <strong>@FocusRequirement.LocalId</strong>: <code>check_gate</code> valida o gate da <strong>funcionalidade/etapa</strong>, nunca um gate individual do requisito.
                </div>
            }

            <div class="v-info-box offline-box">
                <strong>Execução local offline</strong>
                <p class="muted small">Opera exclusivamente sobre o catálogo documental via broker somente leitura, sem agente de IA, sem rede e sem alterar a origem.</p>
            </div>

            @if (availability.Availability != CapabilityAvailability.Available)
            {
                <div class="v-info-box warn-box" role="alert">
                    <strong>check_gate indisponível (@availability.Availability)</strong>
                    <p class="small">@availability.Reason</p>
                </div>
            }

            <div class="v-grid">
                @if (!Compact)
                {
                    <div class="v-field">
                        <label for="@featureId">Funcionalidade</label>
                        <select id="@featureId" aria-label="Funcionalidade do gate" value="@(selectedFeatureId?.ToString() ?? "")" @onchange="OnFeatureChanged" disabled="@isRunning">
                            @foreach (var f in active.Session.Features)
                            {
                                <option value="@f.FeatureId">@f.Title</option>
                            }
                        </select>
                    </div>
                }

                <div class="v-field">
                    <label for="@stageId">Etapa do gate</label>
                    <select id="@stageId" aria-label="Etapa do gate" value="@selectedStage.ToString()" @onchange="OnStageChanged" disabled="@isRunning">
                        <option value="@GateStage.Spec">spec — Especificação</option>
                        <option value="@GateStage.Plan">plan — Plano técnico</option>
                        <option value="@GateStage.Tasks">tasks — Tarefas</option>
                        <option value="@GateStage.Pr">pr — Pull Request</option>
                        <option value="@GateStage.Acceptance">acceptance — Aceite</option>
                        <option value="@GateStage.DevImpossibility">dev-impossibility — Impossibilidade DEV</option>
                    </select>
                </div>

                <div class="v-field v-span-2">
                    <label for="@recordId">Registro do gate</label>
                    @if (featureRecords.Count == 0)
                    {
                        <p class="muted small">Não verificável: nenhum registro em <code>verification/*.json</code> encontrado nesta funcionalidade. Nenhum arquivo será criado.</p>
                    }
                    else
                    {
                        <select id="@recordId" aria-label="Registro do gate" value="@(selectedRecordId?.ToString() ?? "")" @onchange="OnRecordChanged" disabled="@isRunning">
                            @foreach (var rec in featureRecords)
                            {
                                <option value="@rec.DocumentId">@rec.RelativePath.Replace('\\', '/')</option>
                            }
                        </select>
                    }
                </div>

                <div class="v-field v-span-2">
                    <label for="@revisionId">Revisão esperada confirmada</label>
                    <input id="@revisionId" type="text" aria-label="Revisão esperada" value="@expectedRevision" @oninput="OnRevisionInput" disabled="@isRunning" placeholder="sha256:... ou revisão externa informada" />
                    <span class="muted small">@revisionSourceLabel</span>
                </div>
            </div>

            <div class="v-actions">
                <button type="button" class="v-btn-primary"
                        disabled="@(!CanExecuteGate(availability, featureRecords))"
                        @onclick="ExecuteCheckGateAsync">
                    @(isRunning ? "Executando check_gate..." : "Executar verificação")
                </button>
                @if (isRunning)
                {
                    <button type="button" class="v-btn-secondary" @onclick="CancelCurrentRun">Cancelar</button>
                }
            </div>

            @if (isRunning)
            {
                <div class="v-running-banner" role="status" aria-live="polite">
                    <div class="v-running-head">
                        <span class="v-spinner" aria-hidden="true"></span>
                        <strong>@runningStatusText</strong>
                        <span class="v-elapsed">@ElapsedDisplay</span>
                    </div>
                    <div class="v-progress-track" aria-hidden="true"><div class="v-progress-bar"></div></div>
                    <p class="muted small">Processo ativo aguardando resposta do agente documental. Você pode interromper a qualquer momento em <strong>Cancelar</strong>.</p>
                </div>
            }

            @if (Compact && latestCompactRun is not null)
            {
                <div class="v-compact-result" role="region" aria-label="Resultado da verificação">
                    <strong>@FormatRunSummary(latestCompactRun)</strong>
                    <span class="@(latestCompactRun.Freshness == Freshness.Stale ? "fresh-pill stale" : "fresh-pill")">
                        @(latestCompactRun.Freshness == Freshness.Stale ? "Desatualizado" : "Atual")
                    </span>
                    @if (!string.IsNullOrWhiteSpace(latestCompactRun.Reason))
                    {
                        <p class="muted small">@latestCompactRun.Reason</p>
                    }
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public RequirementKey? FocusRequirement { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public EventCallback<VerificationRun> OnRunUpdated { get; set; }

    private readonly string comboId = "v-type-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string featureId = "v-feat-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string focusReqId = "v-freq-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string stageId = "v-stage-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string recordId = "v-rec-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string revisionId = "v-rev-" + Guid.NewGuid().ToString("N")[..8];

    private Guid? lastProjectId;
    private Guid? selectedFeatureId;
    private string selectedFocusLocalId = string.Empty;
    private GateStage selectedStage = GateStage.Spec;
    private Guid? selectedRecordId;
    private string expectedRevision = string.Empty;
    private RevisionSource revisionSource = RevisionSource.ArtifactSha256;
    private string revisionSourceLabel = "Derivada do artefato autorizado (não copiada do registro)";
    private bool revisionEditedByUser;
    private bool isRunning;
    private string runningStatusText = "Executando verificação...";
    private DateTimeOffset? runStartedUtc;
    private CancellationTokenSource? timerCts;
    private CancellationTokenSource? runCts;
    private VerificationRun? latestCompactRun;

    private string ElapsedDisplay
    {
        get
        {
            if (runStartedUtc is not { } started) return "00:00";
            var elapsed = DateTimeOffset.UtcNow - started;
            if (elapsed < TimeSpan.Zero) elapsed = TimeSpan.Zero;
            return $"{(int)elapsed.TotalMinutes:00}:{elapsed.Seconds:00}";
        }
    }

    private void StartLiveTimer(string statusText)
    {
        StopLiveTimer();
        runningStatusText = statusText;
        runStartedUtc = DateTimeOffset.UtcNow;
        var cts = new CancellationTokenSource();
        timerCts = cts;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            try
            {
                while (await timer.WaitForNextTickAsync(cts.Token))
                    await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { }
        });
    }

    private void StopLiveTimer()
    {
        timerCts?.Cancel();
        timerCts?.Dispose();
        timerCts = null;
        runStartedUtc = null;
    }

    protected override void OnInitialized()
    {
        ProjectStore.Changed += OnProjectChanged;
        VerificationStore.Changed += OnVerificationChanged;
        AgentStore.Changed += OnVerificationChanged;
        SyncSelection();
    }

    protected override void OnParametersSet()
    {
        SyncSelection();
    }

    private void OnProjectChanged() => _ = InvokeAsync(() =>
    {
        var active = ProjectStore.Active;
        if (active is not null && active.Catalog.HasPendingChanges)
            VerificationStore.InvalidateProjectRuns(active.Session.ProjectId);
        SyncSelection();
        StateHasChanged();
    });

    private void OnVerificationChanged() => _ = InvokeAsync(() =>
    {
        SyncSelection();
        StateHasChanged();
    });

    private void SyncSelection()
    {
        var active = ProjectStore.Active;
        if (active is null)
        {
            lastProjectId = null;
            selectedFeatureId = null;
            selectedRecordId = null;
            latestCompactRun = null;
            return;
        }

        var projectChanged = lastProjectId != active.Session.ProjectId;
        if (projectChanged)
        {
            lastProjectId = active.Session.ProjectId;
            revisionEditedByUser = false;
            selectedFocusLocalId = string.Empty;
            latestCompactRun = VerificationStore.GetLatestRun(active.Session.ProjectId);
        }

        if (FocusRequirement is not null && FocusRequirement.ProjectId == active.Session.ProjectId)
            selectedFeatureId = FocusRequirement.FeatureId;
        else if (selectedFeatureId is null || active.Session.Features.All(f => f.FeatureId != selectedFeatureId))
            selectedFeatureId = active.Session.ActiveFeatureId ?? active.Session.Features.FirstOrDefault()?.FeatureId;

        var records = GetGateRecords(active);
        if (selectedRecordId is null || records.All(r => r.DocumentId != selectedRecordId))
            selectedRecordId = records.FirstOrDefault()?.DocumentId;

        if (!revisionEditedByUser)
            DeriveRevisionFromArtifact(active);
    }

    private void OnVerificationTypeChanged(ChangeEventArgs e)
    {
        if (ProjectStore.Active is not { } active) return;
        if (Enum.TryParse<VerificationType>(e.Value?.ToString(), out var parsed))
            VerificationStore.SelectVerification(active.Session.ProjectId, parsed);
    }

    private void OnFeatureChanged(ChangeEventArgs e)
    {
        if (ProjectStore.Active is not { } active) return;
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            selectedFeatureId = id;
            selectedFocusLocalId = string.Empty;
            active.Session.SelectFeature(id);
            selectedRecordId = GetGateRecords(active).FirstOrDefault()?.DocumentId;
            revisionEditedByUser = false;
            DeriveRevisionFromArtifact(active);
        }
    }

    private void OnFocusRequirementChanged(ChangeEventArgs e)
    {
        selectedFocusLocalId = e.Value?.ToString() ?? string.Empty;
    }

    private void OnStageChanged(ChangeEventArgs e)
    {
        if (ProjectStore.Active is not { } active) return;
        if (Enum.TryParse<GateStage>(e.Value?.ToString(), out var stage))
        {
            selectedStage = stage;
            revisionEditedByUser = false;
            DeriveRevisionFromArtifact(active);
        }
    }

    private void OnRecordChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            selectedRecordId = id;
    }

    private void OnRevisionInput(ChangeEventArgs e)
    {
        expectedRevision = e.Value?.ToString() ?? string.Empty;
        revisionEditedByUser = true;
        revisionSource = RevisionSource.UserConfirmedExternal;
        revisionSourceLabel = "Revisão externa informada explicitamente pelo usuário (não autenticada)";
    }

    private IReadOnlyList<string> GetFeatureRequirementIds(OpenProjectContext active)
    {
        if (selectedFeatureId is not { } fid) return [];
        try
        {
            return TraceService.ListSheets(active, fid)
                .Select(s => s.Requirement.Key.LocalId)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();
        }
        catch
        {
            return [];
        }
    }

    private IReadOnlyList<string> GetMissingAnalyzePrerequisites(OpenProjectContext active)
    {
        if (selectedFeatureId is not { } fid) return ["funcionalidade"];
        var missing = new List<string>();
        if (!active.Catalog.Entries.Any(e => e.Kind == CatalogKind.Constitution)) missing.Add("constitution.md");
        if (!active.Catalog.Entries.Any(e => e.FeatureId == fid && e.Kind == CatalogKind.Spec)) missing.Add("spec.md");
        if (!active.Catalog.Entries.Any(e => e.FeatureId == fid && e.Kind == CatalogKind.Plan)) missing.Add("plan.md");
        if (!active.Catalog.Entries.Any(e => e.FeatureId == fid && e.Kind == CatalogKind.Tasks)) missing.Add("tasks.md");
        return missing;
    }

    private bool CanExecuteAnalyze(AvailabilityDecision availability, AgentInstallation? selectedAgent) =>
        !isRunning &&
        selectedFeatureId is not null &&
        selectedAgent is not null &&
        selectedAgent.CompatibilityState == AgentCompatibilityState.Compatible &&
        availability.Availability == CapabilityAvailability.Available;

    private async Task ExecuteAnalyzeAsync()
    {
        if (ProjectStore.Active is not { } active || selectedFeatureId is not { } fid)
            return;

        var selectedAgent = AgentStore.GetSelectedAgent(active.Session.ProjectId);
        if (selectedAgent is null) return;

        var availability = AgentStore.EvaluateSelectedAgentAvailability(active.Session.ProjectId);
        var effectiveFocus = FocusRequirement ??
            (!string.IsNullOrWhiteSpace(selectedFocusLocalId)
                ? new RequirementKey(active.Session.ProjectId, fid, selectedFocusLocalId)
                : null);

        var prepared = VerificationStore.PrepareAnalyzeRun(active.Session.ProjectId, fid, selectedAgent, availability, effectiveFocus);
        if (!prepared.Created || prepared.Run is null)
            return;

        var run = prepared.Run;
        latestCompactRun = run;
        if (OnRunUpdated.HasDelegate)
            await OnRunUpdated.InvokeAsync(run);

        if (run.State == RunState.Blocked)
            return;

        isRunning = true;
        runCts = new CancellationTokenSource();
        StartLiveTimer($"Executando speckit-analyze ({selectedAgent.DisplayName})...");
        StateHasChanged();

        try
        {
            if (selectedAgent.Provider == AgentProvider.Codex)
                await CodexAdapter.ExecuteAsync(active, fid, selectedAgent, run, runCts.Token);
            else if (selectedAgent.Provider == AgentProvider.Antigravity)
                await AntigravityAdapter.ExecuteAsync(active, fid, selectedAgent, run, runCts.Token);
            else
                run.MarkFailed($"Adaptador para {selectedAgent.DisplayName} não suportado na V1.");
        }
        finally
        {
            isRunning = false;
            StopLiveTimer();
            runCts.Dispose();
            runCts = null;
            latestCompactRun = run;
            if (OnRunUpdated.HasDelegate)
                await OnRunUpdated.InvokeAsync(run);
            StateHasChanged();
        }
    }

    private IReadOnlyList<CatalogEntry> GetGateRecords(OpenProjectContext active)
    {
        if (selectedFeatureId is not { } fid) return [];
        return active.Catalog.Entries
            .Where(e => e.FeatureId == fid && e.Kind == CatalogKind.GateRecord && e.RelativePath.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
            .OrderBy(e => e.RelativePath, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private void DeriveRevisionFromArtifact(OpenProjectContext active)
    {
        if (selectedFeatureId is not { } fid)
        {
            expectedRevision = string.Empty;
            return;
        }

        var targetKind = selectedStage switch
        {
            GateStage.Plan => CatalogKind.Plan,
            GateStage.Tasks => CatalogKind.Tasks,
            _ => CatalogKind.Spec
        };

        var artifact = active.Catalog.Entries.FirstOrDefault(e => e.FeatureId == fid && e.Kind == targetKind);
        if (artifact is not null && !string.IsNullOrWhiteSpace(artifact.ContentHash))
        {
            expectedRevision = "sha256:" + artifact.ContentHash;
            revisionSource = RevisionSource.ArtifactSha256;
            revisionSourceLabel = $"SHA-256 derivado do artefato autorizado ({Path.GetFileName(artifact.RelativePath)}); nunca copiado do registro.";
        }
        else
        {
            expectedRevision = string.Empty;
            revisionSource = RevisionSource.UserConfirmedExternal;
            revisionSourceLabel = "Nenhum artefato base encontrado; informe a revisão esperada explicitamente.";
        }
    }

    private AvailabilityDecision EvaluateGateAvailability(OpenProjectContext active)
    {
        var pkgStatus = GatePkg.VerifyPackage(active.Catalog.FinalOriginPath);
        if (!pkgStatus.IsValid)
        {
            return new(CapabilityAvailability.Unavailable, pkgStatus.Message ?? "Pacote check_gate inválido.", ProtectedCapability.GateAdapter);
        }

        var runtime = GatePkg.ResolvePythonRuntime(active.Catalog.FinalOriginPath);
        return VerificationStore.EvaluateAvailability(
            VerificationType.CheckGate,
            ProtectedCapability.GateAdapter,
            GatePackage.CoreVersion,
            GatePackage.PlatformFingerprint,
            GatePackage.PolicyVersion,
            runtimeAvailable: runtime.IsAvailable,
            runtimeUnavailableReason: runtime.Message);
    }

    private bool CanExecuteGate(AvailabilityDecision availability, IReadOnlyList<CatalogEntry> records) =>
        !isRunning &&
        availability.Availability == CapabilityAvailability.Available &&
        selectedFeatureId is not null &&
        selectedRecordId is not null &&
        records.Any(r => r.DocumentId == selectedRecordId) &&
        !string.IsNullOrWhiteSpace(expectedRevision);

    private async Task ExecuteCheckGateAsync()
    {
        if (ProjectStore.Active is not { } active || selectedFeatureId is not { } fid || selectedRecordId is not { } rid)
            return;

        var availability = EvaluateGateAvailability(active);
        var candidate = new GateCandidate(
            active.Session.ProjectId,
            fid,
            selectedStage,
            rid,
            expectedRevision.Trim(),
            revisionSource,
            [],
            active.Catalog.Generation,
            revisionSourceLabel);

        var prepared = VerificationStore.PrepareGateRun(active.Session.ProjectId, candidate, availability, FocusRequirement);
        if (!prepared.Created || prepared.Run is null)
            return;

        var run = prepared.Run;
        latestCompactRun = run;
        if (OnRunUpdated.HasDelegate)
            await OnRunUpdated.InvokeAsync(run);

        if (run.State == RunState.Blocked)
            return;

        isRunning = true;
        runCts = new CancellationTokenSource();
        StartLiveTimer($"Executando check_gate ({selectedStage})...");
        StateHasChanged();

        try
        {
            await Executor.ExecuteAsync(active, candidate, run, runCts.Token);
        }
        finally
        {
            isRunning = false;
            StopLiveTimer();
            runCts.Dispose();
            runCts = null;
            latestCompactRun = run;
            if (OnRunUpdated.HasDelegate)
                await OnRunUpdated.InvokeAsync(run);
            StateHasChanged();
        }
    }

    private void CancelCurrentRun()
    {
        runCts?.Cancel();
    }

    private static string FormatRunSummary(VerificationRun run) => run.State switch
    {
        RunState.Completed when run.SemanticResult?.GateResult is { } gr =>
            $"Concluída: {gr switch { GateSemanticResult.Ready => "READY", GateSemanticResult.DevImpossibilityRecorded => "DEV_IMPOSSIBILITY_RECORDED", _ => "BLOCKED" }}",
        RunState.Completed when run.SemanticResult?.AnalyzeResult is { } ar =>
            $"Concluída: {ar switch { AnalyzeSemanticResult.Findings => $"FINDINGS ({run.Findings.Count})", AnalyzeSemanticResult.NoFindings => "NO_FINDINGS", _ => "INCONCLUSIVE" }}",
        RunState.Blocked => "Bloqueada no preflight/escopo",
        RunState.Cancelled => "Cancelada",
        RunState.Failed => "Falha na execução",
        RunState.Running => "Em execução...",
        _ => run.State.ToString()
    };

    public void Dispose()
    {
        ProjectStore.Changed -= OnProjectChanged;
        VerificationStore.Changed -= OnVerificationChanged;
        AgentStore.Changed -= OnVerificationChanged;
        StopLiveTimer();
        runCts?.Cancel();
        runCts?.Dispose();
    }
}
