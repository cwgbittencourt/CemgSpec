@page "/sugestoes"
@implements IDisposable
@using SpecAudit.Application
@using SpecAudit.Components.Reports
@using SpecAudit.Domain
@using SpecAudit.Infrastructure.Reports
@inject ProjectService ProjectStore
@inject DocumentaryDashboardService DashboardService
@inject RequirementTraceService TraceService
@inject VerificationService VerificationStore
@inject FindingDecisionService DecisionService
@inject SavedHistoryService HistoryService
@inject ExternalReportWriter ReportWriter
@inject CapabilityRegistry Capabilities

<section class="suggestions-page">
    <header class="page-header">
        <div>
            <p class="eyebrow">SPECAUDIT · SUGESTÕES, DECISÕES HUMANAS E HISTÓRICO</p>
            <h1>Sugestões</h1>
            <p class="muted">Resultados oficiais permanecem em memória até a ação explícita <strong>Salvar resultados</strong>. A origem auditada nunca é alterada.</p>
        </div>
        <div class="header-actions">
            <button type="button"
                    class="primary"
                    disabled="@(!CanSave)"
                    @onclick="OpenSaveDialog">
                Salvar resultados
            </button>
        </div>
    </header>

    @if (ProjectStore.Active is not { } active)
    {
        <div class="empty-card">
            <p>Nenhum projeto aberto. Selecione um projeto em <a href="/projetos">Projetos</a> para revisar ocorrências e histórico salvo.</p>
        </div>
    }
    else
    {
        <div class="context-bar">
            <strong>@active.Session.DisplayName</strong>
            <span class="readonly-badge">◇ Somente leitura</span>
            <span class="muted">Destino externo: <code>@active.OutputDisplayPath</code></span>
            <span class="save-badge @(lastSaveState == SaveState.Saved ? "saved" : "unsaved")">
                @(lastSaveState switch
                {
                    SaveState.Saved => "Salvo externamente",
                    SaveState.Saving => "Salvando...",
                    SaveState.SaveFailed => "Falha ao salvar",
                    _ => "Não salvo (em memória)"
                })
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(feedbackError))
        {
            <div class="feedback-alert" role="alert">@feedbackError</div>
        }
        @if (!string.IsNullOrWhiteSpace(feedbackSuccess))
        {
            <div class="feedback-ok" role="status">@feedbackSuccess</div>
        }

        <section class="findings-section" aria-label="Ocorrências e sugestões documentais">
            <div class="section-head">
                <h2>Ocorrências e decisões humanas (@currentFindings.Count)</h2>
                <span class="muted small">Decisões humanas nunca apagam o achado técnico original.</span>
            </div>

            @if (currentFindings.Count == 0)
            {
                <p class="muted">Nenhuma ocorrência documental aberta para o projeto selecionado.</p>
            }
            else
            {
                <div class="finding-list">
                    @foreach (var finding in currentFindings)
                    {
                        var draft = GetOrCreateDraft(finding);
                        var decision = DecisionService.GetDecision(active.Session.ProjectId, finding.FindingId);
                        <article class="finding-card">
                            <div class="finding-top">
                                <span class="sev-badge sev-@finding.Severity.ToString().ToLowerInvariant()">@finding.Severity</span>
                                <strong>@finding.Category</strong>
                                <span class="decision-pill">
                                    @FormatClassification(decision?.Classification ?? DecisionClassification.Pending)
                                    @(decision?.NeedsReview == true ? " · Requer revisão" : "")
                                </span>
                            </div>
                            <p class="finding-explanation">@finding.Explanation</p>
                            @if (!string.IsNullOrWhiteSpace(finding.Suggestion))
                            {
                                <p class="finding-suggestion"><strong>Sugestão:</strong> @finding.Suggestion</p>
                            }

                            <div class="decision-form">
                                <label class="field">
                                    <span>Classificação</span>
                                    <select aria-label="Classificação da ocorrência" @bind="draft.Classification">
                                        <option value="@DecisionClassification.Pending">Pendente</option>
                                        <option value="@DecisionClassification.Confirmed">Confirmado</option>
                                        <option value="@DecisionClassification.FalsePositive">Falso positivo</option>
                                        <option value="@DecisionClassification.AcceptedRisk">Risco aceito</option>
                                        <option value="@DecisionClassification.Deferred">Adiado</option>
                                    </select>
                                </label>
                                <label class="field">
                                    <span>Justificativa</span>
                                    <input type="text"
                                           aria-label="Justificativa"
                                           placeholder="Obrigatória para Falso positivo ou Risco aceito"
                                           @bind="draft.Reason" />
                                </label>
                                <label class="field">
                                    <span>Responsável</span>
                                    <input type="text"
                                           aria-label="Responsável"
                                           placeholder="Identificação humana"
                                           @bind="draft.Actor" />
                                </label>
                                <button type="button" class="secondary" @onclick="() => RegisterDecision(active.Session.ProjectId, finding)">
                                    Registrar decisão
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="history-section" role="region" aria-label="Histórico salvo">
            <div class="section-head">
                <h2>Histórico salvo (@savedPackages.Count)</h2>
                <span class="muted small">Espaço ocupado no destino externo: @FormatBytes(totalDiskBytes)</span>
            </div>

            @if (savedPackages.Count == 0)
            {
                <p class="muted">Nenhum pacote oficial salvo no destino externo até o momento.</p>
            }
            else
            {
                <div class="history-list">
                    @foreach (var pkg in savedPackages)
                    {
                        <article class="history-card">
                            <div class="history-meta">
                                <strong>@pkg.DirectoryName</strong>
                                <span class="status-pill @(pkg.IsValid ? "ok" : "warn")">
                                    @(pkg.IsValid ? "Válido" : pkg.IsTampered ? "Adulterado" : "Incompleto")
                                </span>
                                <span class="muted small">@FormatBytes(pkg.TotalBytes)</span>
                                @if (pkg.Record is { } rec)
                                {
                                    <span class="muted small">@rec.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC · @rec.SelectedFormats</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(pkg.DiagnosticMessage))
                            {
                                <p class="muted small">@pkg.DiagnosticMessage</p>
                            }
                            <div class="history-actions">
                                @if (pkg.IsValid)
                                {
                                    <button type="button" class="secondary" @onclick="() => CompareWith(pkg)">Comparar com atual</button>
                                }
                                @if (pkg.Record is { } validRec)
                                {
                                    <button type="button" class="danger" @onclick="() => DeleteRecord(active.Session.ProjectId, validRec.SavedRecordId)">
                                        Excluir registro
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }

            @if (activeDiff is { } diff)
            {
                <div class="diff-panel">
                    <h3>Comparação documental</h3>
                    @if (!diff.IsComparable)
                    {
                        <p class="muted">@diff.InconclusiveReason</p>
                    }
                    else if (diff.Entries.Count == 0)
                    {
                        <p class="muted">Sem diferenças entre o pacote selecionado e as ocorrências atuais.</p>
                    }
                    else
                    {
                        <ul class="diff-list">
                            @foreach (var entry in diff.Entries)
                            {
                                <li>
                                    <span class="diff-badge">@entry.Status</span>
                                    <strong>@entry.Category</strong>: @entry.Explanation
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </section>

        <SaveDialog IsOpen="@isSaveDialogOpen"
                    IsSaving="@(lastSaveState == SaveState.Saving)"
                    ProjectDisplayName="@active.Session.DisplayName"
                    DestinationPath="@active.OutputDisplayPath"
                    IsStale="@active.Catalog.HasPendingChanges"
                    FindingsCount="@currentFindings.Count"
                    DecisionsCount="@DecisionService.GetDecisions(active.Session.ProjectId).Count"
                    OnConfirm="ConfirmSaveAsync"
                    OnCancel="() => isSaveDialogOpen = false" />
    }
</section>

@code {
    private sealed class DecisionDraft
    {
        public DecisionClassification Classification { get; set; } = DecisionClassification.Pending;
        public string Reason { get; set; } = string.Empty;
        public string Actor { get; set; } = string.Empty;
    }

    private readonly Dictionary<Guid, DecisionDraft> drafts = [];
    private IReadOnlyList<Finding> currentFindings = [];
    private IReadOnlyList<SavedPackageSummary> savedPackages = [];
    private long totalDiskBytes;
    private HistoryDiffResult? activeDiff;
    private SaveState lastSaveState = SaveState.Unsaved;
    private bool isSaveDialogOpen;
    private string? feedbackError;
    private string? feedbackSuccess;

    private bool IsExternalWriterAvailable =>
        Capabilities.Availability(
            ProtectedCapability.ExternalWriter,
            ExternalReportWriter.WriterVersion,
            ExternalReportWriter.PlatformFingerprint,
            ExternalReportWriter.PolicyVersion) == CapabilityAvailability.Available;

    private bool CanSave => ProjectStore.Active is not null && IsExternalWriterAvailable;

    protected override void OnInitialized()
    {
        ProjectStore.Changed += OnStateChanged;
        DecisionService.Changed += OnStateChanged;
        HistoryService.Changed += OnStateChanged;
        RefreshData();
    }

    public void Dispose()
    {
        ProjectStore.Changed -= OnStateChanged;
        DecisionService.Changed -= OnStateChanged;
        HistoryService.Changed -= OnStateChanged;
    }

    private void OnStateChanged()
    {
        RefreshData();
        InvokeAsync(StateHasChanged);
    }

    private void RefreshData()
    {
        if (ProjectStore.Active is not { } active)
        {
            currentFindings = [];
            savedPackages = [];
            totalDiskBytes = 0;
            activeDiff = null;
            return;
        }

        var findings = new List<Finding>();
        var sheets = TraceService.ListSheets(active);
        foreach (var sheet in sheets)
        {
            foreach (var f in sheet.Findings)
            {
                var stableId = DeterministicGuid($"{active.Session.ProjectId:N}|{f.Category}|{f.ContextFingerprint}");
                findings.Add(f with { FindingId = stableId });
            }
        }

        if (findings.Count == 0)
        {
            var stableId = DeterministicGuid($"{active.Session.ProjectId:N}|documentary-baseline");
            findings.Add(new Finding(
                stableId,
                null,
                "Revisão documental",
                FindingSeverity.Info,
                "Leitura documental concluída sem lacunas explícitas de vínculo na matriz atual.",
                [],
                "Registrar revisão humana ou salvar pacote externo quando desejar.",
                "baseline|ok"));
        }

        currentFindings = findings;
        DecisionService.ReconcileContextChanges(active.Session.ProjectId, currentFindings);
        savedPackages = HistoryService.ListSaved(active.Session.ProjectId);
        totalDiskBytes = savedPackages.Sum(p => p.TotalBytes);
    }

    private DecisionDraft GetOrCreateDraft(Finding finding)
    {
        if (!drafts.TryGetValue(finding.FindingId, out var draft))
        {
            draft = new DecisionDraft();
            if (ProjectStore.Active is { } active &&
                DecisionService.GetDecision(active.Session.ProjectId, finding.FindingId) is { } existing)
            {
                draft.Classification = existing.Classification;
                draft.Reason = existing.Reason ?? string.Empty;
                draft.Actor = existing.Actor ?? string.Empty;
            }
            drafts[finding.FindingId] = draft;
        }
        return draft;
    }

    private void RegisterDecision(Guid projectId, Finding finding)
    {
        feedbackError = null;
        feedbackSuccess = null;
        var draft = GetOrCreateDraft(finding);
        try
        {
            DecisionService.Classify(projectId, finding, draft.Classification, draft.Reason, draft.Actor);
            feedbackSuccess = $"Decisão '{FormatClassification(draft.Classification)}' registrada em memória.";
        }
        catch (ArgumentException ex)
        {
            feedbackError = $"Não foi possível registrar a decisão: {ex.Message} (justificativa e responsável obrigatórios).";
        }
    }

    private void OpenSaveDialog()
    {
        feedbackError = null;
        feedbackSuccess = null;
        isSaveDialogOpen = true;
    }

    private Task ConfirmSaveAsync(ExportFormat formats)
    {
        if (ProjectStore.Active is not { } active) return Task.CompletedTask;

        lastSaveState = SaveState.Saving;
        feedbackError = null;
        feedbackSuccess = null;

        var dashboard = DashboardService.Build(active);
        var decisions = DecisionService.GetDecisions(active.Session.ProjectId);
        var sourceHashes = active.Catalog.Entries
            .ToDictionary(e => e.RelativePath, e => $"gen:{active.Catalog.Generation}|id:{e.DocumentId:N}", StringComparer.OrdinalIgnoreCase);

        var payload = new ReportExportPayload(
            SavedRecordId: Guid.NewGuid(),
            ProjectId: active.Session.ProjectId,
            ProjectDisplayName: active.Session.DisplayName,
            Scope: "Projeto completo",
            CreatedUtc: DateTimeOffset.UtcNow,
            IsStale: active.Catalog.HasPendingChanges,
            SelectedFormats: formats,
            DestinationIdentity: active.Session.OutputDirectoryIdentity,
            SourceHashes: sourceHashes,
            ToolVersions: [$"SpecAudit ExternalWriter {ExternalReportWriter.WriterVersion}"],
            Limitations:
            [
                "Auditoria exclusivamente documental; não lê nem analisa código-fonte.",
                "Percentuais documentais não representam percentual de implementação."
            ],
            Findings: currentFindings,
            Decisions: decisions,
            Indicators: dashboard);

        var result = ReportWriter.Save(active, payload);
        lastSaveState = result.State;
        isSaveDialogOpen = false;

        if (result.State == SaveState.Saved)
        {
            feedbackSuccess = result.Message;
            RefreshData();
        }
        else
        {
            feedbackError = result.Message ?? "Falha ao salvar pacote externo.";
        }

        return Task.CompletedTask;
    }

    private void CompareWith(SavedPackageSummary pkg)
    {
        activeDiff = HistoryService.Compare(pkg, currentFindings, currentSampleIsComplete: true);
    }

    private void DeleteRecord(Guid projectId, Guid savedRecordId)
    {
        feedbackError = null;
        feedbackSuccess = null;
        var res = HistoryService.DeleteSaved(projectId, savedRecordId);
        if (res.Deleted)
        {
            feedbackSuccess = res.Message;
            activeDiff = null;
            RefreshData();
        }
        else
        {
            feedbackError = res.Message;
        }
    }

    private static string FormatClassification(DecisionClassification classification) => classification switch
    {
        DecisionClassification.Pending => "Pendente",
        DecisionClassification.Confirmed => "Confirmado",
        DecisionClassification.FalsePositive => "Falso positivo",
        DecisionClassification.AcceptedRisk => "Risco aceito",
        DecisionClassification.Deferred => "Adiado",
        _ => classification.ToString()
    };

    private static string FormatBytes(long bytes) =>
        bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024.0:F1} KB";

    private static Guid DeterministicGuid(string input)
    {
        var hash = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(input));
        Span<byte> bytes = stackalloc byte[16];
        hash.AsSpan(0, 16).CopyTo(bytes);
        return new Guid(bytes);
    }
}
