@page "/verificacoes"
@implements IDisposable
@using SpecAudit.Application
@using SpecAudit.Components.Verifications
@using SpecAudit.Domain
@inject ProjectService ProjectStore
@inject VerificationService VerificationStore

<PageTitle>Verificações — SpecAudit</PageTitle>

<section class="verif-page">
    <header class="verif-header">
        <div>
            <p class="eyebrow">SPECAUDIT · VERIFICAÇÕES PERMITIDAS</p>
            <h1>Verificações</h1>
            <p class="muted">Execute verificações documentais permitidas na V1 sem alterar os arquivos da origem.</p>
        </div>
    </header>

    @if (ProjectStore.Active is not { } active)
    {
        <section class="project-empty">
            <div class="folder-mark" aria-hidden="true">▷</div>
            <h2>Nenhum projeto carregado</h2>
            <p>Abra um projeto em <a href="/projetos">Projetos</a> para configurar e executar verificações permitidas.</p>
        </section>
    }
    else
    {
        <div class="verif-context-cards">
            <article class="ctx-card">
                <p class="ctx-label">PROJETO · SOMENTE LEITURA</p>
                <strong class="ctx-path">@active.Session.OriginDisplayPath</strong>
                <span class="ctx-meta">◇ Somente leitura · Gravação bloqueada na origem · Geração #@active.Catalog.Generation</span>
            </article>
            <article class="ctx-card">
                <p class="ctx-label">RESULTADOS · PASTA EXTERNA</p>
                <strong class="ctx-path">@active.OutputDisplayPath</strong>
                <span class="ctx-meta">Resultados oficiais permanecem em memória até ação explícita Salvar.</span>
            </article>
        </div>

        @if (active.Catalog.HasPendingChanges)
        {
            <div role="status" class="notice">
                Documentos da origem foram alterados externamente. Resultados anteriores foram marcados como desatualizados sem reexecução automática.
                <button type="button" class="secondary" @onclick="RefreshCatalog">Atualizar catálogo</button>
            </div>
        }

        <div class="verif-grid">
            <article class="verif-card">
                <h2>Configurar verificação</h2>
                <VerificationSelector OnRunUpdated="HandleRunUpdated" />
            </article>

            <section class="verif-card" role="region" aria-label="Resultado da verificação">
                <div class="result-head">
                    <h2>Última execução</h2>
                    @if (latestRun is not null)
                    {
                        <span class="@(latestRun.Freshness == Freshness.Stale ? "state-pill warn-pill" : "state-pill ok-pill")">
                            @(latestRun.Freshness == Freshness.Stale ? "Desatualizado" : "Atual")
                        </span>
                    }
                </div>

                @if (latestRun is null)
                {
                    <p class="muted small">Nenhuma verificação executada nesta sessão para este projeto. Selecionar uma opção na combo nunca dispara execução automática.</p>
                }
                else
                {
                    <div class="result-badges">
                        <span class="@StateBadgeClass(latestRun.State)">@StateLabel(latestRun.State)</span>
                        @if (latestRun.SemanticResult?.GateResult is { } gateSemantic)
                        {
                            <span class="@SemanticBadgeClass(gateSemantic)">@SemanticLabel(gateSemantic)</span>
                        }
                        @if (latestRun.ExitCode is { } exitCode)
                        {
                            <span class="state-pill muted-pill">Exit @exitCode</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(latestRun.ToolIdentifier))
                    {
                        <p class="mono small">Ferramenta: @latestRun.ToolIdentifier</p>
                    }

                    @if (latestRun.StartedUtc is { } started && latestRun.EndedUtc is { } ended)
                    {
                        <p class="muted small">Duração: @((ended - started).TotalSeconds.ToString("F2")) s · Em memória (não salvo oficialmente)</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(latestRun.Reason))
                    {
                        <div class="result-reason">@latestRun.Reason</div>
                    }

                    <div class="result-limits">
                        <strong>Limites explícitos</strong>
                        @if (latestRun.Limitations.Count == 0)
                        {
                            <p class="muted small">check_gate valida integridade e estado registrados nos documentos; não autentica decisão humana nem testa implementação.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var lim in latestRun.Limitations)
                                {
                                    <li class="muted small">@lim</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </section>
        </div>

        @if (latestRun is not null)
        {
            <article class="verif-card">
                <div class="detail-tabs" role="tablist" aria-label="Detalhes da execução">
                    <button type="button" role="tab" aria-selected="@(activeTab == DetailTab.Summary ? "true" : "false")"
                            class="@(activeTab == DetailTab.Summary ? "d-tab active" : "d-tab")"
                            @onclick="() => activeTab = DetailTab.Summary">Resumo (@latestRun.Findings.Count)</button>
                    <button type="button" role="tab" aria-selected="@(activeTab == DetailTab.Output ? "true" : "false")"
                            class="@(activeTab == DetailTab.Output ? "d-tab active" : "d-tab")"
                            @onclick="() => activeTab = DetailTab.Output">Saída completa</button>
                </div>

                @if (activeTab == DetailTab.Summary)
                {
                    @if (latestRun.Findings.Count == 0)
                    {
                        <p class="muted small">Nenhuma ocorrência registrada nesta execução.</p>
                    }
                    else
                    {
                        <ul class="findings-list">
                            @foreach (var finding in latestRun.Findings)
                            {
                                <li>
                                    <strong>@finding.Category</strong> · <span class="muted small">@finding.Severity</span>
                                    <p class="small">@finding.Explanation</p>
                                </li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <div class="output-block">
                        <strong>Stdout</strong>
                        <pre>@(string.IsNullOrWhiteSpace(latestRun.Output) ? "(vazio)" : latestRun.Output)</pre>
                        <strong>Stderr</strong>
                        <pre>@(string.IsNullOrWhiteSpace(latestRun.ErrorOutput) ? "(vazio)" : latestRun.ErrorOutput)</pre>
                    </div>
                }
            </article>
        }
    }
</section>

@code {
    private enum DetailTab { Summary, Output }

    private VerificationRun? latestRun;
    private DetailTab activeTab = DetailTab.Summary;

    protected override void OnInitialized()
    {
        ProjectStore.Changed += OnProjectChanged;
        VerificationStore.Changed += OnVerificationChanged;
        SyncLatestRun();
    }

    private void OnProjectChanged() => _ = InvokeAsync(() =>
    {
        var active = ProjectStore.Active;
        if (active is not null && active.Catalog.HasPendingChanges)
            VerificationStore.InvalidateProjectRuns(active.Session.ProjectId);
        SyncLatestRun();
        StateHasChanged();
    });

    private void OnVerificationChanged() => _ = InvokeAsync(() =>
    {
        SyncLatestRun();
        StateHasChanged();
    });

    private void SyncLatestRun()
    {
        var active = ProjectStore.Active;
        latestRun = active is null ? null : VerificationStore.GetLatestRun(active.Session.ProjectId);
    }

    private void HandleRunUpdated(VerificationRun run)
    {
        latestRun = run;
        StateHasChanged();
    }

    private void RefreshCatalog()
    {
        if (ProjectStore.Active is not { } active) return;
        ProjectStore.Refresh(active.Session.ProjectId);
        VerificationStore.InvalidateProjectRuns(active.Session.ProjectId);
        SyncLatestRun();
    }

    private static string StateLabel(RunState state) => state switch
    {
        RunState.Completed => "Concluída",
        RunState.Blocked => "Bloqueada",
        RunState.Failed => "Falha na execução",
        RunState.Cancelled => "Cancelada",
        RunState.Running => "Em execução",
        RunState.Preparing => "Preparando",
        _ => state.ToString()
    };

    private static string StateBadgeClass(RunState state) => state switch
    {
        RunState.Completed => "state-pill ok-pill",
        RunState.Blocked => "state-pill warn-pill",
        RunState.Failed => "state-pill danger-pill",
        _ => "state-pill muted-pill"
    };

    private static string SemanticLabel(GateSemanticResult result) => result switch
    {
        GateSemanticResult.Ready => "READY",
        GateSemanticResult.DevImpossibilityRecorded => "DEV_IMPOSSIBILITY_RECORDED",
        _ => "BLOCKED"
    };

    private static string SemanticBadgeClass(GateSemanticResult result) => result switch
    {
        GateSemanticResult.Ready => "state-pill ok-pill",
        GateSemanticResult.DevImpossibilityRecorded => "state-pill warn-pill",
        _ => "state-pill danger-pill"
    };

    public void Dispose()
    {
        ProjectStore.Changed -= OnProjectChanged;
        VerificationStore.Changed -= OnVerificationChanged;
    }
}
