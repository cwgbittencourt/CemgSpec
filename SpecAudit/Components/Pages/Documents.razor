@page "/documentos"
@implements IDisposable
@using System.Text
@using SpecAudit.Application
@using SpecAudit.Components.Documents
@using SpecAudit.Domain
@using SpecAudit.Infrastructure.Documents
@inject ProjectService ProjectStore

<PageTitle>Documentos — SpecAudit</PageTitle>

<section class="docs-page">
    <header class="docs-header">
        <div>
            <p class="eyebrow">SPECAUDIT · LEITURA DOCUMENTAL</p>
            <h1>Documentos</h1>
            <p class="muted">Leitura dos artefatos do projeto. A origem permanece somente leitura.</p>
        </div>
        <div class="docs-search-wrap">
            <input type="search" class="docs-search" aria-label="Buscar documentos" placeholder="Buscar nos documentos"
                   value="@searchQuery" @oninput="OnSearchInput" disabled="@(ProjectStore.Active is null)" />
        </div>
    </header>

    @if (ProjectStore.Active is not { } active)
    {
        <section class="project-empty">
            <div class="folder-mark" aria-hidden="true">▤</div>
            <h2>Nenhum projeto carregado</h2>
            <p>Abra um projeto em <a href="/projetos">Projetos</a> para navegar pelos documentos e registros SpecKit.</p>
            <p class="muted">A leitura não cria arquivos, não altera a origem e não executa verificações.</p>
        </section>
    }
    else
    {
        <div class="docs-context-bar">
            <span class="docs-project-chip"><strong>@active.Session.DisplayName</strong></span>
            <span class="readonly-badge">◇ Somente leitura</span>
            <span class="docs-output-meta" title="@active.OutputDisplayPath">Destino externo: <code>@active.OutputDisplayPath</code></span>
        </div>

        @if (active.Catalog.HasPendingChanges)
        {
            <div role="status" class="notice">
                Os documentos foram alterados externamente. Atualize a leitura antes de continuar.
                <button type="button" class="secondary" @onclick="Refresh">Atualizar documentos</button>
            </div>
        }

        <div class="docs-workspace">
            <aside class="docs-tree-panel" aria-label="Árvore de documentos">
                <div class="panel-title">Artefatos do catálogo</div>
                @if (tree.Count == 0)
                {
                    <p class="muted tree-empty">@(string.IsNullOrWhiteSpace(searchQuery) ? "Nenhum documento SpecKit encontrado." : "Nenhum documento encontrado para a busca.")</p>
                }
                else
                {
                    <ul role="tree" aria-label="Documentos" class="doc-tree">
                        @foreach (var folder in tree)
                        {
                            <DocumentTreeNode @key="folder.Key" Folder="folder" Level="1" SelectedId="@selectedId" Collapsed="collapsedFolders"
                                              Searching="@(!string.IsNullOrWhiteSpace(searchQuery))"
                                              OnToggle="ToggleFolder" OnOpen="OpenDocument" />
                        }
                    </ul>
                }
            </aside>

            <div class="docs-reader-panel">
                <div class="reader-bar">
                    <div class="reader-tab-info">
                        <span class="reader-file-name">@(selectedEntry is null ? "Nenhum documento selecionado" : Path.GetFileName(selectedEntry.RelativePath))</span>
                        @if (selectedEntry is not null)
                        {
                            <span class="reader-file-path" title="@selectedEntry.RelativePath">@selectedEntry.RelativePath</span>
                        }
                    </div>
                    <div role="tablist" aria-label="Modo de leitura" class="mode-tabs">
                        <button type="button" role="tab" aria-selected="@(mode == ViewMode.Preview ? "true" : "false")"
                                class="@(mode == ViewMode.Preview ? "mode-tab active" : "mode-tab")"
                                @onclick="() => SetMode(ViewMode.Preview)">Preview</button>
                        <button type="button" role="tab" aria-selected="@(mode == ViewMode.Source ? "true" : "false")"
                                class="@(mode == ViewMode.Source ? "mode-tab active" : "mode-tab")"
                                @onclick="() => SetMode(ViewMode.Source)">Fonte</button>
                        <button type="button" role="tab" aria-selected="@(mode == ViewMode.Split ? "true" : "false")"
                                class="@(mode == ViewMode.Split ? "mode-tab active" : "mode-tab")"
                                @onclick="() => SetMode(ViewMode.Split)">Lado a lado</button>
                    </div>
                </div>

                @if (errorMessage is not null)
                {
                    <div role="alert" class="notice error-notice doc-banner">@errorMessage</div>
                }
                @if (statusMessage is not null)
                {
                    <div role="status" class="notice doc-banner">@statusMessage</div>
                }

                @if (session is not null && selectedEntry is not null)
                {
                    <div class="@(mode == ViewMode.Split ? "doc-panes split" : "doc-panes")">
                        <MarkdownPreview @ref="previewComponent" Session="session" DocumentId="selectedEntry.DocumentId"
                                         Hidden="@(mode == ViewMode.Source)" InitialElementId="@pendingElementId"
                                         Navigate="OnPreviewNavigate" Status="OnPreviewStatus" />
                        <section class="source-pane" aria-label="Fonte Markdown" hidden="@(mode == ViewMode.Preview)">
                            <pre class="source-code">@session.Preview.Source</pre>
                        </section>
                    </div>
                }
                else if (errorMessage is null)
                {
                    <div class="reader-empty">
                        <p class="muted">Selecione um documento na árvore à esquerda para ler em Preview, Fonte ou Lado a lado.</p>
                    </div>
                }
            </div>

            <aside class="docs-outline-panel" aria-label="Contexto do documento">
                <section class="context-card">
                    <h2>Neste documento</h2>
                    @if (session is null || session.Preview.Headings.Count == 0)
                    {
                        <p class="muted small">Nenhum título indexado neste documento.</p>
                    }
                    else
                    {
                        <nav aria-label="Títulos do documento">
                            <ul class="outline-list">
                                @foreach (var heading in session.Preview.Headings)
                                {
                                    <li class="outline-item level-@Math.Clamp(heading.Level, 1, 4)">
                                        <button type="button" class="outline-link" @onclick="() => GoToHeadingAsync(heading.ElementId)">@heading.Text</button>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </section>

                <section class="context-card">
                    <h2>Procedência documental</h2>
                    @if (selectedEntry is not null)
                    {
                        <dl class="provenance-list">
                            <dt>Arquivo</dt>
                            <dd>@selectedEntry.RelativePath</dd>
                            <dt>Categoria</dt>
                            <dd>@KindLabel(selectedEntry.Kind)</dd>
                            <dt>Geração do catálogo</dt>
                            <dd>#@selectedEntry.CatalogGeneration</dd>
                            <dt>Proteção</dt>
                            <dd>Leitura via broker; sem edição ou scripts.</dd>
                        </dl>
                    }
                    else
                    {
                        <p class="muted small">Selecione um documento para ver a procedência e o estado do catálogo.</p>
                    }
                    <p class="muted small">Ocorrências e vínculos de requisitos ficam disponíveis nas próximas etapas (Dashboard e Requisitos).</p>
                </section>
            </aside>
        </div>
    }
</section>

@code {
    private enum ViewMode { Preview, Source, Split }

    private static readonly UTF8Encoding Utf8 = new(false, throwOnInvalidBytes: true);

    private ViewMode mode = ViewMode.Preview;
    private string searchQuery = "";
    private Guid? activeProjectId;
    private long activeGeneration = -1;
    private Guid? selectedId;
    private CatalogEntry? selectedEntry;
    private DocumentPreviewSession? session;
    private string? pendingElementId;
    private string? statusMessage;
    private string? errorMessage;
    private SpecAudit.Components.Documents.MarkdownPreview? previewComponent;
    private IReadOnlyList<DocumentTreeFolder> tree = [];
    private readonly HashSet<string> collapsedFolders = new(StringComparer.Ordinal);
    private readonly Dictionary<Guid, string?> contentCache = [];

    protected override void OnInitialized()
    {
        ProjectStore.Changed += OnProjectsChanged;
        SyncProject();
    }

    private void OnProjectsChanged() => _ = InvokeAsync(() =>
    {
        SyncProject();
        StateHasChanged();
    });

    private void SyncProject()
    {
        var active = ProjectStore.Active;
        if (active is null)
        {
            activeProjectId = null;
            activeGeneration = -1;
            selectedId = null;
            selectedEntry = null;
            session = null;
            pendingElementId = null;
            statusMessage = null;
            errorMessage = null;
            tree = [];
            contentCache.Clear();
            return;
        }

        var projectChanged = activeProjectId != active.Session.ProjectId;
        var generationChanged = activeGeneration != active.Catalog.Generation;
        if (projectChanged || generationChanged)
        {
            activeProjectId = active.Session.ProjectId;
            activeGeneration = active.Catalog.Generation;
            contentCache.Clear();
            if (projectChanged)
            {
                searchQuery = "";
                collapsedFolders.Clear();
                selectedId = null;
                selectedEntry = null;
                session = null;
                pendingElementId = null;
                statusMessage = null;
                errorMessage = null;
            }
        }

        RebuildTree();

        if (selectedId is { } id && active.Catalog.Entries.Any(entry => entry.DocumentId == id && entry.Kind != CatalogKind.PresentationAsset))
        {
            if (session is null || generationChanged)
                LoadDocument(id, null);
        }
        else if (selectedId is null)
        {
            var initial = PickDefaultDocument(active);
            if (initial is not null)
                LoadDocument(initial.DocumentId, null);
        }
        else
        {
            selectedId = null;
            selectedEntry = null;
            session = null;
        }
    }

    private static CatalogEntry? PickDefaultDocument(OpenProjectContext active)
    {
        var docs = active.Catalog.Entries.Where(entry => entry.Kind != CatalogKind.PresentationAsset).ToArray();
        if (active.Session.ActiveFeatureId is { } featureId)
        {
            var spec = docs.FirstOrDefault(entry => entry.FeatureId == featureId && entry.Kind == CatalogKind.Spec);
            if (spec is not null) return spec;
            var anyInFeature = docs.FirstOrDefault(entry => entry.FeatureId == featureId);
            if (anyInFeature is not null) return anyInFeature;
        }
        return docs.FirstOrDefault();
    }

    private void RebuildTree()
    {
        var active = ProjectStore.Active;
        if (active is null)
        {
            tree = [];
            return;
        }

        var query = searchQuery.Trim();
        tree = DocumentTreeBuilder.Build(active.Catalog.Entries, active.Catalog.Features, (entry, displayPath) =>
        {
            if (query.Length == 0) return DocumentMatch.Path;
            if (displayPath.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                entry.RelativePath.Contains(query, StringComparison.OrdinalIgnoreCase))
                return DocumentMatch.Path;
            return MatchesContent(active, entry, query) ? DocumentMatch.Content : DocumentMatch.None;
        });
    }

    private bool MatchesContent(OpenProjectContext active, CatalogEntry entry, string query)
    {
        if (!contentCache.TryGetValue(entry.DocumentId, out var text))
        {
            try
            {
                var snapshot = ProjectStore.ReadDocument(active.Session.ProjectId, entry.DocumentId);
                var bytes = snapshot.CopyBytes().AsSpan();
                if (bytes.StartsWith(Encoding.UTF8.Preamble))
                    bytes = bytes[Encoding.UTF8.Preamble.Length..];
                text = Utf8.GetString(bytes);
            }
            catch (Exception failure) when (DocumentMessages.IsReadFailure(failure) || failure is DecoderFallbackException)
            {
                text = null;
            }
            contentCache[entry.DocumentId] = text;
        }
        return text is not null && text.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        searchQuery = args.Value?.ToString() ?? "";
        RebuildTree();
    }

    private void ToggleFolder(string key)
    {
        if (!collapsedFolders.Add(key))
            collapsedFolders.Remove(key);
    }

    private void OpenDocument(Guid documentId) => LoadDocument(documentId, null);

    private void LoadDocument(Guid documentId, string? elementId)
    {
        if (ProjectStore.Active is not { } active) return;
        statusMessage = null;
        errorMessage = null;
        try
        {
            var entry = active.Catalog.Entries.SingleOrDefault(candidate =>
                candidate.DocumentId == documentId && candidate.Kind != CatalogKind.PresentationAsset)
                ?? throw new DocumentAccessException("OutOfScope");
            var opened = ProjectStore.OpenPreview(active.Session.ProjectId, documentId);
            selectedId = documentId;
            selectedEntry = entry;
            session = opened;
            pendingElementId = elementId;
        }
        catch (Exception failure) when (DocumentMessages.IsReadFailure(failure))
        {
            errorMessage = DocumentMessages.For(failure);
        }
    }

    private void SetMode(ViewMode next)
    {
        mode = next;
    }

    private void OnPreviewNavigate(SpecAudit.Components.Documents.MarkdownPreview.PreviewNavigation navigation)
    {
        LoadDocument(navigation.DocumentId, navigation.ElementId);
    }

    private void OnPreviewStatus(string message)
    {
        statusMessage = message;
    }

    private async Task GoToHeadingAsync(string elementId)
    {
        if (mode == ViewMode.Source)
            mode = ViewMode.Preview;
        if (previewComponent is not null)
            await previewComponent.GoToAsync(elementId);
    }

    private void Refresh()
    {
        if (ProjectStore.Active is not { } active) return;
        errorMessage = null;
        statusMessage = null;
        try
        {
            ProjectStore.Refresh(active.Session.ProjectId);
            SyncProject();
        }
        catch (Exception failure) when (DocumentMessages.IsReadFailure(failure))
        {
            errorMessage = DocumentMessages.For(failure);
        }
    }

    private static string KindLabel(CatalogKind kind) => kind switch
    {
        CatalogKind.Constitution => "Constituição",
        CatalogKind.Spec => "Especificação",
        CatalogKind.Plan => "Plano",
        CatalogKind.Tasks => "Tarefas",
        CatalogKind.Checklist => "Checklist",
        CatalogKind.Research => "Pesquisa",
        CatalogKind.Design => "Design",
        CatalogKind.GateRecord => "Registro de gate",
        CatalogKind.EvidenceDocument => "Evidência documental",
        _ => "Documento"
    };

    public void Dispose() => ProjectStore.Changed -= OnProjectsChanged;
}
